# Point this domain's DNS A record (and optional AAAA record) at the Linode.
APP_DOMAIN=propflow.example.com

# Replace both placeholders before deployment. Use unique random values.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Optional Firebase web app configuration for chat features.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional backend Firebase Admin credentials. Configure ADC/service-account
# mounting in compose.yaml before enabling Firebase-backed chat in production.
FIREBASE_PROJECT_ID=
