# Copy to .env and adjust for your environment
PORT=5005
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
DB_PATH=./data/propflow.db
CORS_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=your-firebase-project-id
# Point to a Firebase service account JSON file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/firebase-service-account.json
# Admin bootstrap (created on first run if no admin exists)
ADMIN_EMAIL=admin@propflow.test
ADMIN_PASSWORD=Admin@12345