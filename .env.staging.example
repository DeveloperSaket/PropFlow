# Staging hostname, routed by host Nginx.
APP_DOMAIN=stg.negobrick.com
BACKEND_ENV_FILE=.env.staging

# Use staging-only credentials, never production credentials.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=staging-admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Optional Firebase web app configuration for chat testing.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

FIREBASE_PROJECT_ID=
